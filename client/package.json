  "version": "0.1.1",
  "description": "CLI to upload files to a Fileslop server and get a public URL. Made for humans and AI agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fileslop": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esukram/fileslop.git",
    "directory": "client"
  },
  "homepage": "https://github.com/esukram/fileslop#readme",
  "bugs": "https://github.com/esukram/fileslop/issues",
  "keywords": [
    "upload",
    "file-sharing",
    "s3",
    "cli",
    "ai-agents",
    "github"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  }
}
