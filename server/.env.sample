# Fileslop server configuration.
# Copy this file to .env and set the values. Real environment variables win over this file.

# Public URL of the service. The path of this URL is the route prefix.
FILESLOP_PUBLIC_URL=https://files.example.org/fileslop/
# Listen address and port. 0.0.0.0 listens on all interfaces.
FILESLOP_HOST=0.0.0.0
FILESLOP_PORT=8080

# Object store backend: aws_s3 or hetzner.
FILESLOP_BACKEND=hetzner
FILESLOP_S3_ACCESS_KEY_ID=
FILESLOP_S3_SECRET_ACCESS_KEY=
FILESLOP_S3_BUCKET=
# aws_s3 only: AWS region of the bucket.
#FILESLOP_S3_REGION=eu-central-1
# hetzner only: location of the bucket (fsn1, nbg1, hel1).
FILESLOP_HETZNER_LOCATION=fsn1
# Optional: endpoint of another S3-compatible store. Uses path-style URLs.
#FILESLOP_S3_ENDPOINT=http://127.0.0.1:9000

# Directory in the bucket for all files.
FILESLOP_BASE_DIR=fileslop
# Local directory for keys.txt and index.jsonl. Use persistent storage.
FILESLOP_DATA_DIR=./data
# Largest upload in bytes. Default: 26214400 (25 MiB).
FILESLOP_MAX_UPLOAD_BYTES=26214400
